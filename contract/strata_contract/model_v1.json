{
  "contract_version": 1,
  "architecture": "apple.depthpro2-h.single-frame",
  "opset": 23,
  "input": {
    "name": "image",
    "dtype": "float32",
    "layout": "NCHW",
    "shape": [
      1,
      3,
      "height",
      "width"
    ]
  },
  "output": {
    "name": "network_inverse_depth",
    "dtype": "float32",
    "shape": [
      1,
      1,
      "height",
      "width"
    ],
    "semantics": "focal-normalized inverse optical-axis depth"
  },
  "preprocessing": {
    "color": "display-sRGB",
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ],
    "padding": "bottom-right-replicate",
    "multiple": 32,
    "max_height": 4352,
    "max_width": 7680,
    "linear_exposure": "multiply by exp2(stops), clip to [0,1], apply sRGB",
    "srgb_threshold": 0.0031308,
    "srgb_linear_scale": 12.92,
    "srgb_power_scale": 1.055,
    "srgb_power_offset": 0.055,
    "srgb_gamma": 2.4
  },
  "postprocessing": {
    "crop": "original input dimensions",
    "camera_z_metres": "focal_px / (original_width * network_inverse_depth)",
    "inverse_metres": "original_width * network_inverse_depth / focal_px",
    "zero_network_inverse_depth": "camera_z_metres=positive infinity, inverse_metres=0"
  },
  "fov": {
    "suffix": ".fov.onnx",
    "input_name": "image",
    "input_dtype": "float32",
    "input_shape": [
      1,
      3,
      "height",
      "width"
    ],
    "output_name": "fov_deg",
    "output_dtype": "float32",
    "output_shape": [
      1,
      2
    ],
    "resize": "separable bilinear antialias, half-pixel centers, round ties to even",
    "short_side_max": 512,
    "aspect_max": 1.7778,
    "focal": "0.5 * shorter_original_side / tan(shorter_side_fov_deg * pi / 360)"
  },
  "deep": {
    "channels": [
      "R",
      "G",
      "B",
      "A",
      "Z",
      "ZBack"
    ],
    "dtype": "float32",
    "samples_per_pixel": 1,
    "alpha": 1,
    "zback": "Z",
    "rgb": "unmodified input RGB",
    "alpha_semantics": "coverage",
    "rgb_association": "premultiplied"
  }
}
