import numpy as np
from numpy.typing import NDArray

class Rotation:
    @classmethod
    def from_euler(cls, seq: str, angles: NDArray[np.float64]) -> Rotation: ...
    @classmethod
    def from_matrix(cls, matrix: NDArray[np.float64]) -> Rotation: ...
    @classmethod
    def from_rotvec(cls, rotvec: NDArray[np.float64]) -> Rotation: ...
    def as_matrix(self) -> NDArray[np.float64]: ...

class Slerp:
    def __init__(self, times: NDArray[np.float64], rotations: Rotation) -> None: ...
    def __call__(self, times: NDArray[np.float64]) -> Rotation: ...
